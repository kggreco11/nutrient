{
  "name": "nutrient",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-hosted.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "format": "prettier --write app tests index.html capacitor.config.json"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@zxing/browser": "^0.2.1"
  }
}
