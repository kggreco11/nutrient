{
  "name": "nutrient-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local server/dev.js",
    "build": "node scripts/build-hosted.mjs",
    "test": "node --test tests/*.test.js",
    "test:native": "sh scripts/test-native-models.sh",
    "ios:sync": "node scripts/sync-native-data.mjs",
    "ios:open": "open ios/App/App.xcodeproj",
    "format": "prettier --write server shared scripts/*.mjs tests/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
